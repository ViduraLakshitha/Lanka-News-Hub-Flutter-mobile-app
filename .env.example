# ==============================================================================
# Lanka News Hub — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure values appropriate for your environment:
# - Local Development: APP_ENV=local, APP_DEBUG=true, DB_DRIVER=sqlite or mysql
# - Staging:           APP_ENV=staging, APP_DEBUG=false, DB_DRIVER=mysql
# - Production:        APP_ENV=production, APP_DEBUG=false, DB_DRIVER=mysql
# ==============================================================================

# Application & Environment
APP_NAME="Lanka News Hub"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://news.example.lk
APP_TIMEZONE=Asia/Colombo

# Database Configuration (MySQL / MariaDB recommended for Staging & Production)
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=news_hub_prod
DB_USER=news_db_user
DB_PASSWORD=ChangeToAStrongSecurePassword!
# SQLite path (Used only when DB_DRIVER=sqlite. Must be outside public document root)
# DB_PATH=/absolute/path/to/storage/news.sqlite

# Session & Authentication Security
# Session lifetime in seconds (86400 = 24 hours)
SESSION_LIFETIME=86400
# Force HTTPS-only session cookies (set to true on staging and production)
SESSION_SECURE_COOKIE=true

# Cache & Performance Layer
# Options: 'none' (disabled), 'file' (local storage/cache), 'redis' (production Redis object cache)
CACHE_DRIVER=none
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Logging Configuration
# Application logs are written to storage/logs/app.log and storage/logs/error.log
LOG_CHANNEL=file

# Mail / Transactional Notification Settings (Optional)
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@example.lk
MAIL_FROM_NAME="Lanka News Hub"

# Initial Provisioning Secret (Used only by CLI: bin/admin.php)
# Never leave set in persistent environment files on shared machines.
# NEWS_ADMIN_PASSWORD=

# Programmatic Advertising / Google AdSense (Optional)
# Never hardcode live publisher IDs. Configure test/staging ID or leave blank.
# Format: ca-pub-XXXXXXXXXXXXXXXX
GOOGLE_ADSENSE_ID=
