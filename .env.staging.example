# ==============================================================================
# Lanka News Hub — STAGING ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application & Environment
APP_NAME="Lanka News Hub [STAGING]"
APP_ENV=staging
APP_DEBUG=false
APP_URL=https://staging.news.example.lk
APP_TIMEZONE=Asia/Colombo

# Database Configuration (MySQL / MariaDB matching production layout)
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=news_hub_staging
DB_USER=news_staging_user
DB_PASSWORD=SecureStagingPasswordChangeMe!

# Session & Cookie Security (Strict HTTPS enforced)
SESSION_LIFETIME=86400
SESSION_SECURE_COOKIE=true

# Cache Subsystem
CACHE_DRIVER=file

# Logging
LOG_CHANNEL=file

# Mail / Notifications (Staging Mailgun / SendGrid sandbox)
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=staging_smtp_user
MAIL_PASSWORD=staging_smtp_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=staging-noreply@example.lk
MAIL_FROM_NAME="Lanka News Hub Staging"

# Programmatic Advertising (Sandbox / Blank)
GOOGLE_ADSENSE_ID=
