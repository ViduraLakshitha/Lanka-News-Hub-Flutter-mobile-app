# ==============================================================================
# Lanka News Hub — LOCAL DEVELOPMENT ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application & Environment
APP_NAME="Lanka News Hub [LOCAL]"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8080
APP_TIMEZONE=Asia/Colombo

# Database Configuration (SQLite recommended for rapid local dev)
DB_DRIVER=sqlite
DB_PATH=storage/preview.sqlite

# Optional MySQL Configuration (if using local MySQL server):
# DB_DRIVER=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=news_hub_dev
# DB_USER=root
# DB_PASSWORD=

# Session Security (Disabled secure cookies for HTTP localhost)
SESSION_LIFETIME=86400
SESSION_SECURE_COOKIE=false

# Cache Subsystem
CACHE_DRIVER=file

# Logging
LOG_CHANNEL=file

# Mail / Notifications (Local Mailhog / Mailpit or dummy)
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=dev@localhost.lk
MAIL_FROM_NAME="Lanka News Hub Dev"
