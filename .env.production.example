# ==============================================================================
# Lanka News Hub — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application & Environment
APP_NAME="Lanka News Hub"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://news.liontech.lk
APP_TIMEZONE=Asia/Colombo

# Database Configuration (High-Performance MySQL 8.0+ / MariaDB 10.4+)
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=news_hub_prod
DB_USER=news_prod_user
DB_PASSWORD=CHANGE_ME_TO_SUPER_SECURE_RANDOM_PASSWORD_64_CHARS

# Session & Cookie Security (Shared across subdomains: news., sinhala., tamil.)
SESSION_LIFETIME=86400
SESSION_SECURE_COOKIE=true
SESSION_COOKIE_DOMAIN=.news.liontech.lk

# Cache Subsystem (Redis recommended for high traffic production)
CACHE_DRIVER=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_TO_REDIS_AUTH_TOKEN

# Logging
LOG_CHANNEL=file

# Production Transactional Mail
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=prod_smtp_user
MAIL_PASSWORD=prod_smtp_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@example.lk
MAIL_FROM_NAME="Lanka News Hub"

# Production Google AdSense Client ID (if active)
GOOGLE_ADSENSE_ID=ca-pub-XXXXXXXXXXXXXXXX
